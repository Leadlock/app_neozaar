{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "neozaar-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:verification-link": "node scripts/local-verification-link.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:setup-db": "node ./__tests__/setup-test-db.js",
    "pretest": "npm run test:setup-db",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-marketplace-catalog": "^3.1123.0",
    "@aws-sdk/client-s3": "^3.1123.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "openai": "^6.10.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "ssh2-sftp-client": "^12.0.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^8.42.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3"
  },
  "description": "A Node.js Express backend for the NeoZaar SaaS platform with PostgreSQL database.",
